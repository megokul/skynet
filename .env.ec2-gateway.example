# EC2 Dockerized gateway profile (SSH-primary)
OPENCLAW_EXECUTION_MODE=ssh_tunnel
SKYNET_ORCHESTRATION_MODE=legacy
SKYNET_ORCHESTRATION_ALLOW_ACP_WITH_SSH=0
OPENCLAW_SSH_FALLBACK_ENABLED=1
OPENCLAW_SSH_HOST=host.docker.internal
OPENCLAW_SSH_PORT=2222
OPENCLAW_SSH_USER=iamgo
OPENCLAW_SSH_KEY_PATH=/app/keys/laptop_ed25519
OPENCLAW_SSH_KEY_FILE=.secrets/laptop_ed25519
OPENCLAW_SSH_REMOTE_OS=windows
OPENCLAW_SSH_ALLOWED_ROOTS=E:\SKYNET-SANDBOX
OPENCLAW_SSH_CONNECT_TIMEOUT=8
OPENCLAW_SSH_COMMAND_TIMEOUT=180
OPENCLAW_SSH_HEALTH_CACHE_SECONDS=15
OPENCLAW_SSH_MAX_PARALLEL=2
OPENCLAW_SSH_CIRCUIT_BREAKER_SECONDS=60
OPENCLAW_SSH_CAPACITY_BACKOFF_SECONDS=30
OPENCLAW_SSH_HEALTH_PROBE_TIMEOUT=6

# Canonical worker reverse-tunnel settings (used by scripts/* on laptop)
OPENCLAW_TUNNEL_EC2_HOST=ec2-3-212-193-68.compute-1.amazonaws.com
OPENCLAW_TUNNEL_EC2_USER=ubuntu
OPENCLAW_TUNNEL_SSH_KEY=E:\MyProjects\skynet-key.pem
OPENCLAW_TUNNEL_REMOTE_BIND_HOST=0.0.0.0
OPENCLAW_TUNNEL_REMOTE_PORT=2222
OPENCLAW_TUNNEL_LOCAL_PORT=22

SKYNET_CODING_TRANSPORT=ssh_first
SKYNET_CODING_FALLBACK_CHAIN=codex
SKYNET_CODEX_WRITE_MODE=danger_full_access
SKYNET_CLAUDE_OLLAMA_STAGE_ENABLED=0
SKYNET_PLANNER_PRIMARY_AGENT=codex
SKYNET_CONTROL_LOOP_ENABLED=1
SKYNET_CONTROL_LOOP_FORCE_FOR_ALL=1
SKYNET_CONTROL_LOOP_DEFAULT_PROFILE=loop_v1
SKYNET_CONTROL_LOOP_SCHEDULER_ENABLED=1
SKYNET_CONTROL_LOOP_MAX_PARALLEL_NODES=2
SKYNET_CONTROL_LOOP_DEADLOCK_IDLE_TICKS=3
SKYNET_CONTROL_LOOP_REPAIR_RETRIES=1
SKYNET_CONTROL_LOOP_BUDGET_MAX_ITERATIONS=40
SKYNET_CONTROL_LOOP_BUDGET_MAX_RUNTIME_SECONDS=3600
SKYNET_CONTROL_LOOP_BUDGET_MAX_REPAIRS=1
SKYNET_CONTROL_LOOP_BUDGET_MAX_TOKENS=250000
SKYNET_CONTROL_LOOP_FAILURE_CLASSIFIER_ENABLED=1
SKYNET_CONTROL_LOOP_CRITIC_BLOCK_THRESHOLD=high
SKYNET_CONTROL_LOOP_REVIEW_CRITIC_ENABLED=1
SKYNET_CONTROL_LOOP_REVIEW_TIMEOUT_SECONDS=120
SKYNET_CONTROL_LOOP_MEMORY_ENABLED=1
SKYNET_CONTROL_LOOP_CODE_INDEX_ENABLED=1
SKYNET_CONTROL_LOOP_CODE_INDEX_GLOBS=*.py,*.js,*.ts,*.tsx
SKYNET_CONTROL_LOOP_CONTEXT_COMPRESSION_ENABLED=1
SKYNET_CONTROL_LOOP_CONTEXT_MAX_CHARS=12000
SKYNET_CONTROL_LOOP_CONTEXT_TOPK=12
SKYNET_CONTROL_LOOP_TRACE_ENABLED=1
SKYNET_CONTROL_LOOP_TRACE_RETENTION_DAYS=14
SKYNET_CONTROL_LOOP_TOOL_AWARE_ENABLED=1
SKYNET_CONTROL_LOOP_ARCH_CRITIC_ENABLED=1
SKYNET_CONTROL_LOOP_ARCH_RULES_FILE=openclaw-gateway/settings/architecture_rules.yaml
SKYNET_CONTROL_LOOP_COMPLETION_CONTRACT_REQUIRED=1
SKYNET_CONTROL_LOOP_PLANNER_AGENT=codex
SKYNET_CONTROL_LOOP_CRITIC_AGENT=codex
SKYNET_CONTROL_LOOP_ROUTER_FALLBACK_ENABLED=0
SKYNET_E2E_FAIL_ON_SKIP=1
