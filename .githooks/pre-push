#!/usr/bin/env sh
set -eu

# Set SKYNET_SKIP_ENV_SYNC=1 to bypass this sync for a single push.
if [ "${SKYNET_SKIP_ENV_SYNC:-0}" = "1" ]; then
  exit 0
fi

if [ ! -f ".env" ]; then
  exit 0
fi

# Default: strict sync. Set SKYNET_ENV_SYNC_STRICT=0 to allow push on sync failures.
strict_mode="${SKYNET_ENV_SYNC_STRICT:-1}"
sync_rc=0

if command -v python >/dev/null 2>&1; then
  python scripts/dev/sync_env_to_github.py --mode secrets --quiet || sync_rc=$?
elif command -v py >/dev/null 2>&1; then
  py -3 scripts/dev/sync_env_to_github.py --mode secrets --quiet || sync_rc=$?
else
  sync_rc=2
fi

if [ "$sync_rc" -ne 0 ]; then
  if [ "$strict_mode" = "0" ]; then
    echo "pre-push: env sync failed (exit=$sync_rc); continuing push (SKYNET_ENV_SYNC_STRICT=0)." >&2
    exit 0
  fi
  echo "pre-push: env sync failed (exit=$sync_rc) and strict mode is enabled, blocking push." >&2
  echo "pre-push: set SKYNET_ENV_SYNC_STRICT=0 to bypass temporarily." >&2
  exit "$sync_rc"
fi

exit 0
