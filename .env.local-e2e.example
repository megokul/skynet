# Local host-run live E2E profile.
# Non-secret defaults come from settings YAML.
SKYNET_SETTINGS_FILE=./openclaw-gateway/settings/settings.yaml

# Live test toggles
SKYNET_E2E_LIVE=1
SKYNET_E2E_FAIL_ON_SKIP=1
SKYNET_LIVE_E2E_FLOW=conversation

# SSH credential secret for worker access (pick one)
OPENCLAW_SSH_PASSWORD=
# OPENCLAW_SSH_PRIVATE_KEY_B64=
OPENCLAW_SSH_KEY_PATH=E:\MyProjects\skynet-key.pem

# Canonical reverse-tunnel owner settings (worker-side scripts)
OPENCLAW_TUNNEL_SSH_KEY=E:\MyProjects\skynet-key.pem
OPENCLAW_TUNNEL_EC2_HOST=
OPENCLAW_TUNNEL_EC2_USER=
OPENCLAW_TUNNEL_REMOTE_BIND_HOST=0.0.0.0
OPENCLAW_TUNNEL_REMOTE_PORT=2222
OPENCLAW_TUNNEL_LOCAL_PORT=22

# Optional: fully real Telegram-network E2E
# Set SKYNET_LIVE_E2E_FLOW=telegram_real and provide:
SKYNET_E2E_TELEGRAM_API_ID=
SKYNET_E2E_TELEGRAM_API_HASH=
SKYNET_E2E_TELEGRAM_SESSION=
SKYNET_E2E_TELEGRAM_BOT_USERNAME=

# Telegram-real live container log stream (always-on recommended)
SKYNET_E2E_CONTAINER_LOG_STREAM_ENABLED=1
SKYNET_E2E_CONTAINER_LOG_SOURCES=openclaw-gateway,skynet-api
SKYNET_E2E_CONTAINER_LOG_REQUIRE_STREAM=1
SKYNET_E2E_CONTAINER_LOG_MAX_LINE_CHARS=1200
SKYNET_E2E_CONTAINER_LOG_RING_LINES=300
# Optional explicit EC2 SSH override for container log stream.
# If empty, test resolves from OPENCLAW_TUNNEL_EC2_HOST/USER/OPENCLAW_TUNNEL_SSH_KEY.
SKYNET_E2E_CONTAINER_LOG_SSH_HOST=
SKYNET_E2E_CONTAINER_LOG_SSH_USER=
SKYNET_E2E_CONTAINER_LOG_SSH_KEY=
SKYNET_E2E_CONTAINER_LOG_SSH_PORT=22
SKYNET_E2E_RUNTIME_TRACE_STALE_SECONDS=90
SKYNET_E2E_RUNTIME_TRACE_FILE=E:\MyProjects\skynet\logs\skynet.trace.log

# Optional tracker overrides (normally set in settings YAML)
SKYNET_ORCHESTRATION_MODE=
SKYNET_ORCHESTRATION_ALLOW_ACP_WITH_SSH=
SKYNET_OPENCLAW_QUEUE_MODE=
SKYNET_OPENCLAW_TRACE_ENABLED=
SKYNET_RUNTIME_TRACE_ENABLED=
SKYNET_RUNTIME_TRACE_LIVE_FILE=
SKYNET_RUNTIME_TRACE_LEVEL=
SKYNET_RUNTIME_TRACE_PAYLOAD_MODE=
SKYNET_RUNTIME_TRACE_INCLUDE_STDIO_TAIL=
SKYNET_RUNTIME_TRACE_STDIO_TAIL_BYTES=
SKYNET_RUNTIME_TRACE_DB_ENABLED=
SKYNET_RUNTIME_TRACE_REQUIRE_DEBUG_BUNDLE=
SKYNET_RUNTIME_TRACE_REQUIRED_EVENT_ENFORCEMENT=
SKYNET_CODEX_WRITE_MODE=
SKYNET_CLAUDE_OLLAMA_STAGE_ENABLED=
SKYNET_PLANNER_PRIMARY_AGENT=
SKYNET_PLANNER_ROUTER_FALLBACK_ENABLED=
SKYNET_CONTROL_LOOP_ENABLED=
SKYNET_CONTROL_LOOP_FORCE_FOR_ALL=
SKYNET_CONTROL_LOOP_DEFAULT_PROFILE=
SKYNET_CONTROL_LOOP_SCHEDULER_ENABLED=
SKYNET_CONTROL_LOOP_MAX_PARALLEL_NODES=
SKYNET_CONTROL_LOOP_DEADLOCK_IDLE_TICKS=
SKYNET_CONTROL_LOOP_REPAIR_RETRIES=
