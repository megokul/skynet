# EC2 Dockerized gateway profile (SSH-primary)
OPENCLAW_EXECUTION_MODE=ssh_tunnel
SKYNET_ORCHESTRATION_MODE=legacy
SKYNET_ORCHESTRATION_ALLOW_ACP_WITH_SSH=0
OPENCLAW_SSH_FALLBACK_ENABLED=1
OPENCLAW_SSH_HOST=host.docker.internal
OPENCLAW_SSH_PORT=2222
OPENCLAW_SSH_USER=iamgo
OPENCLAW_SSH_KEY_PATH=/app/keys/laptop_ed25519
OPENCLAW_SSH_KEY_FILE=.secrets/laptop_ed25519
OPENCLAW_SSH_REMOTE_OS=windows
OPENCLAW_SSH_ALLOWED_ROOTS=E:\SKYNET-SANDBOX
OPENCLAW_SSH_CONNECT_TIMEOUT=8
OPENCLAW_SSH_COMMAND_TIMEOUT=180
OPENCLAW_SSH_HEALTH_CACHE_SECONDS=15
OPENCLAW_SSH_MAX_PARALLEL=2
OPENCLAW_SSH_CIRCUIT_BREAKER_SECONDS=60
OPENCLAW_SSH_CAPACITY_BACKOFF_SECONDS=30
OPENCLAW_SSH_HEALTH_PROBE_TIMEOUT=6

# Canonical worker reverse-tunnel settings (used by scripts/* on laptop)
OPENCLAW_TUNNEL_EC2_HOST=ec2-3-212-193-68.compute-1.amazonaws.com
OPENCLAW_TUNNEL_EC2_USER=ubuntu
OPENCLAW_TUNNEL_SSH_KEY=E:\MyProjects\skynet-key.pem
OPENCLAW_TUNNEL_REMOTE_BIND_HOST=0.0.0.0
OPENCLAW_TUNNEL_REMOTE_PORT=2222
OPENCLAW_TUNNEL_LOCAL_PORT=22

SKYNET_CODING_TRANSPORT=ssh_first
SKYNET_E2E_FAIL_ON_SKIP=1
