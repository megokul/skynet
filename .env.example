# SKYNET / OpenClaw environment example

# SKYNET control-plane API
# Full stack (this repo): http://openclaw-gateway:8766
# SKYNET-only mode (existing gateway on host): http://host.docker.internal:8766
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:8766
# OPENCLAW_GATEWAY_URLS=http://openclaw-a:8766,http://openclaw-b:8766
SKYNET_DB_PATH=/app/data/skynet.db
CORS_ORIGINS=*
SKYNET_API_KEY=

# OpenClaw gateway integration (optional but recommended)
SKYNET_AUTH_TOKEN=
SKYNET_ORCHESTRATOR_URL=http://localhost:8000
OPENCLAW_HTTP_HOST=0.0.0.0
OPENCLAW_HTTP_PORT=8766

# OpenClaw Telegram runtime
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DISABLE_TELEGRAM_BOT=0

# Logging sinks
# 0 = do not write app log files in Linux container filesystem
SKYNET_LOG_ENABLE_LOCAL_FILES=0
# 1 = mirror logs to local Windows machine over SSH tunnel
SKYNET_LOG_ENABLE_SSH_MIRROR=1
SKYNET_TRACE_MIRROR_LOG_DIR=E:\SKYNET-SANDBOX\logs
# 1 = upload runtime/control-flow logs to S3 in batches
SKYNET_LOG_S3_ENABLED=1
SKYNET_LOG_S3_PREFIX=openclaw/logs

# AI providers
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ONLY_MODE=0
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-vl-235b-a22b-thinking,openai/gpt-oss-120b:free,qwen/qwen3-coder:free,google/gemma-3n-e2b-it:free,deepseek/deepseek-r1-0528:free,meta-llama/llama-3.3-70b-instruct:free
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER_PRIORITY=claude,gemini,openai,deepseek,openrouter,groq,ollama
AUTO_APPROVE_GIT_ACTIONS=1
AUTO_APPROVE_AND_START=1
AUTO_PLAN_MIN_IDEAS=3
AUTO_BOOTSTRAP_PROJECT=1
AUTO_CREATE_GITHUB_REPO=1
AUTO_CREATE_GITHUB_PRIVATE=0
SKYNET_STRICT_QUALITY_GATES_ENABLED=1
SKYNET_STRICT_QUALITY_GATES_DEFAULT_PROFILE=strict
SKYNET_STRICT_QUALITY_GATES_FIX_RETRIES=1
SKYNET_STRICT_EMPTY_OUTPUT_EMERGENCY_SCAFFOLD=1
SKYNET_CODING_DEFAULT_PROFILE=codex_primary
SKYNET_CODING_FORCE_PRIMARY_FOR_ALL=1
SKYNET_CODING_FALLBACK_CHAIN=codex,claude_ollama,cline
SKYNET_PLANNER_PRIMARY_AGENT=codex
SKYNET_PLANNER_CODEX_TIMEOUT_SECONDS=120
SKYNET_MILESTONE_CODEX_TIMEOUT_SECONDS=120
SKYNET_CODING_TRANSPORT=ssh_first
SKYNET_E2E_FAIL_ON_SKIP=1
SKYNET_LIVE_E2E_FLOW=conversation
SKYNET_E2E_TELEGRAM_API_ID=
SKYNET_E2E_TELEGRAM_API_HASH=
SKYNET_E2E_TELEGRAM_SESSION=
SKYNET_E2E_TELEGRAM_BOT_USERNAME=
SKYNET_CODING_PROGRESS_HEARTBEAT_SECONDS=30
SKYNET_CODING_AGENT_MAX_WAIT_SECONDS=900
SKYNET_MILESTONE_EXTRACTION_HEARTBEAT_SECONDS=20
SKYNET_MILESTONE_EXTRACTION_MAX_WAIT_SECONDS=180
OPENCLAW_EXECUTION_MODE=ssh_tunnel
OPENCLAW_SSH_FALLBACK_ENABLED=1
# EC2 Dockerized gateway runtime:
# OPENCLAW_SSH_HOST=host.docker.internal and OPENCLAW_SSH_PORT=2222.
# Worker-host live E2E should use .env.local-e2e profile (127.0.0.1:22).
OPENCLAW_SSH_HOST=host.docker.internal
OPENCLAW_SSH_PORT=2222
OPENCLAW_SSH_USER=
OPENCLAW_SSH_PASSWORD=
OPENCLAW_SSH_KEY_PATH=/app/keys/laptop_ed25519
OPENCLAW_SSH_KEY_FILE=.secrets/laptop_ed25519
OPENCLAW_SSH_CONNECT_TIMEOUT=8
OPENCLAW_SSH_COMMAND_TIMEOUT=180
OPENCLAW_SSH_HEALTH_CACHE_SECONDS=15
OPENCLAW_SSH_REMOTE_OS=windows
OPENCLAW_SSH_ALLOWED_ROOTS=E:\SKYNET-SANDBOX
OPENCLAW_SSH_STRICT_HOST_KEY=0
OPENCLAW_SSH_CODEX_BIN=codex
OPENCLAW_SSH_CLAUDE_BIN=claude
OPENCLAW_SSH_CLINE_BIN=cline
OPENCLAW_SSH_MAX_PARALLEL=2
OPENCLAW_SSH_CIRCUIT_BREAKER_SECONDS=60
OPENCLAW_SSH_CAPACITY_BACKOFF_SECONDS=30
OPENCLAW_SSH_HEALTH_PROBE_TIMEOUT=6
SKYNET_CLAUDE_OLLAMA_BASE_URL=http://localhost:11434
SKYNET_CLAUDE_OLLAMA_AUTH_TOKEN=ollama
SKYNET_CLAUDE_OLLAMA_DEFAULT_MODEL=qwen3-coder
SKYNET_CLAUDE_OLLAMA_AUTO_PULL=1
SKYNET_CLAUDE_OLLAMA_MIN_CONTEXT=64000

# Optional: local coding agent CLI binaries on the laptop agent host
# (used by run_coding_agent: codex | claude | cline)
SKYNET_CODEX_BIN=codex
SKYNET_CLAUDE_BIN=claude
SKYNET_CLINE_BIN=cline
SKYNET_PROJECT_BASE_DIR=~/Projects
OPENCLAW_SSH_CLAUDE_PERMISSION_MODE=bypassPermissions
OPENCLAW_SSH_CLAUDE_DISABLE_SLASH_COMMANDS=0
OPENCLAW_SSH_CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=0

# Optional: external OpenClaw SKILL.md packs (prompt guidance)
# 1) Directory scan (recursive): load every SKILL.md in this folder
SKYNET_EXTERNAL_SKILLS_DIR=./openclaw-gateway/external-skills
# 2) Optional remote fetch (comma-separated GitHub URLs to SKILL.md or skill folder)
# SKYNET_EXTERNAL_SKILL_URLS=https://github.com/openclaw/skills/tree/main/skills/steipete/coding-agent/SKILL.md

# AWS S3 (optional)
SKYNET_S3_BUCKET=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
