# Secrets-only env template for SKYNET/OpenClaw.
# Non-secret defaults now live in: openclaw-gateway/settings/settings.yaml
# Override settings file path only when needed.
SKYNET_SETTINGS_FILE=/app/settings/settings.yaml

# Control plane + bot auth
SKYNET_API_KEY=
SKYNET_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# AI provider credentials
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=

# GitHub auth for repo/bootstrap actions
GH_TOKEN=

# SSH credential secrets (choose password or private key)
OPENCLAW_SSH_PASSWORD=
OPENCLAW_SSH_PRIVATE_KEY_B64=

# Real Telegram E2E credentials (required only for SKYNET_LIVE_E2E_FLOW=telegram_real)
SKYNET_E2E_TELEGRAM_API_ID=
SKYNET_E2E_TELEGRAM_API_HASH=
SKYNET_E2E_TELEGRAM_SESSION=
SKYNET_E2E_TELEGRAM_BOT_USERNAME=

# Optional non-secret overrides (normally set in openclaw-gateway/settings/settings.yaml)
SKYNET_ORCHESTRATION_MODE=
SKYNET_OPENCLAW_RUNTIME=
SKYNET_OPENCLAW_QUEUE_MODE=
SKYNET_OPENCLAW_RETRY_TRANSIENT=
SKYNET_OPENCLAW_SESSION_TIMEOUT_SECONDS=
SKYNET_OPENCLAW_STAGE_CHAIN=
SKYNET_OPENCLAW_AGENT_HOSTING=
SKYNET_OPENCLAW_TRACE_ENABLED=
SKYNET_OPENCLAW_CLI_BIN=
OPENCLAW_CODEX_BIN=
OPENCLAW_CLAUDE_BIN=
OPENCLAW_CLINE_BIN=
SKYNET_TELEGRAM_TRACKER_ENABLED=
SKYNET_TELEGRAM_TRACKER_EDIT_INTERVAL_SECONDS=
SKYNET_TELEGRAM_TRACKER_STALE_WARN_SECONDS=
SKYNET_TELEGRAM_TRACKER_BAR_WIDTH=
SKYNET_TELEGRAM_TRACKER_VERBOSE_PIPELINE=
