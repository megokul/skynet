# Secrets-only env template for SKYNET/OpenClaw.
# Non-secret defaults now live in: openclaw-gateway/settings/settings.yaml
# Override settings file path only when needed.
SKYNET_SETTINGS_FILE=/app/settings/settings.yaml

# Control plane + bot auth
SKYNET_API_KEY=
SKYNET_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# AI provider credentials
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=

# GitHub auth for repo/bootstrap actions
GH_TOKEN=

# SSH credential secrets (choose password or private key)
OPENCLAW_SSH_PASSWORD=
OPENCLAW_SSH_PRIVATE_KEY_B64=

# Worker reverse-tunnel owner settings (non-secret defaults)
# Canonical worker key:
OPENCLAW_TUNNEL_SSH_KEY=E:\MyProjects\skynet-key.pem
# Optional fallback used by tunnel scripts when OPENCLAW_TUNNEL_SSH_KEY is unset.
OPENCLAW_SSH_KEY_PATH=E:\MyProjects\skynet-key.pem
OPENCLAW_TUNNEL_EC2_HOST=
OPENCLAW_TUNNEL_EC2_USER=
OPENCLAW_TUNNEL_REMOTE_BIND_HOST=0.0.0.0
OPENCLAW_TUNNEL_REMOTE_PORT=2222
OPENCLAW_TUNNEL_LOCAL_PORT=22

# Real Telegram E2E credentials (required only for SKYNET_LIVE_E2E_FLOW=telegram_real)
SKYNET_E2E_TELEGRAM_API_ID=
SKYNET_E2E_TELEGRAM_API_HASH=
SKYNET_E2E_TELEGRAM_SESSION=
SKYNET_E2E_TELEGRAM_BOT_USERNAME=

# Optional non-secret overrides (normally set in openclaw-gateway/settings/settings.yaml)
SKYNET_ORCHESTRATION_MODE=
SKYNET_ORCHESTRATION_ALLOW_ACP_WITH_SSH=
SKYNET_OPENCLAW_RUNTIME=
SKYNET_OPENCLAW_QUEUE_MODE=
SKYNET_OPENCLAW_RETRY_TRANSIENT=
SKYNET_OPENCLAW_SESSION_TIMEOUT_SECONDS=
SKYNET_OPENCLAW_STAGE_CHAIN=
SKYNET_OPENCLAW_AGENT_HOSTING=
SKYNET_OPENCLAW_TRACE_ENABLED=
SKYNET_OPENCLAW_CLI_BIN=
OPENCLAW_CODEX_BIN=
OPENCLAW_CLAUDE_BIN=
OPENCLAW_CLINE_BIN=
SKYNET_CODEX_WRITE_MODE=
SKYNET_CLAUDE_OLLAMA_STAGE_ENABLED=
SKYNET_PLANNER_PRIMARY_AGENT=
SKYNET_CONTROL_LOOP_ENABLED=
SKYNET_CONTROL_LOOP_FORCE_FOR_ALL=
SKYNET_CONTROL_LOOP_DEFAULT_PROFILE=
SKYNET_CONTROL_LOOP_SCHEDULER_ENABLED=
SKYNET_CONTROL_LOOP_MAX_PARALLEL_NODES=
SKYNET_CONTROL_LOOP_DEADLOCK_IDLE_TICKS=
SKYNET_CONTROL_LOOP_REPAIR_RETRIES=
SKYNET_CONTROL_LOOP_BUDGET_MAX_ITERATIONS=
SKYNET_CONTROL_LOOP_BUDGET_MAX_RUNTIME_SECONDS=
SKYNET_CONTROL_LOOP_BUDGET_MAX_REPAIRS=
SKYNET_CONTROL_LOOP_BUDGET_MAX_TOKENS=
SKYNET_CONTROL_LOOP_FAILURE_CLASSIFIER_ENABLED=
SKYNET_CONTROL_LOOP_CRITIC_BLOCK_THRESHOLD=
